{
  "realm": "naruworks",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "browserFlow": "naru-browser",
  "identityProviders": [
    {
      "alias": "google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": true,
      "firstBrokerLoginFlowAlias": "naru-first-broker-login",
      "config": {
        "clientId": "${GOOGLE_CLIENT_ID}",
        "clientSecret": "${GOOGLE_CLIENT_SECRET}",
        "defaultScope": "openid email profile",
        "syncMode": "IMPORT"
      }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "naru-browser",
      "description": "Redirect straight to Google; no Keycloak login page",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "identity-provider-redirector",
          "authenticatorConfig": "naru-idp-redirector",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        }
      ]
    },
    {
      "alias": "naru-first-broker-login",
      "description": "Create or auto-link the user without showing any page",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-create-user-if-unique",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticator": "idp-auto-link",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "naru-idp-redirector",
      "config": {
        "defaultProvider": "google"
      }
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "member",
        "description": "NaruWorks 승인 회원. 상태가 APPROVED일 때만 backend가 부여한다"
      }
    ]
  },
  "clients": [
    {
      "clientId": "naru-api",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${KEYCLOAK_NARU_API_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "${KEYCLOAK_REDIRECT_URI}"
      ],
      "attributes": {
        "post.logout.redirect.uris": "${KEYCLOAK_POST_LOGOUT_REDIRECT_URI}",
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "naru-api-admin",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${KEYCLOAK_ADMIN_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "service-account-naru-api-admin",
      "enabled": true,
      "serviceAccountClientId": "naru-api-admin",
      "clientRoles": {
        "realm-management": ["manage-users"]
      }
    }
  ]
}
