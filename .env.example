POSTGRES_DB=change_me_database
POSTGRES_USER=change_me_user
POSTGRES_PASSWORD=change_me_password

SPRING_PROFILES_ACTIVE=local

# Local host URL for frontend dev server outside Docker.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081

# Docker-internal URL for the Next.js server container.
CATALOG_API_BASE_URL=http://backend:8080

# Cloudflare Tunnel token. Keep the real value only in the server .env file.
CLOUDFLARED_TUNNEL_TOKEN=change_me_cloudflare_tunnel_token

NARU_INITIAL_ADMIN_EMAIL=본인구글이메일

# NaruWorks login goes through the Keycloak IdP (OIDC) and Google. Never commit real values.
# Google OAuth "Web application" client used by Keycloak for login.
# Authorized redirect URI: <KEYCLOAK_HOSTNAME>/realms/naruworks/broker/google/endpoint
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Keycloak. Generate secrets with: openssl rand -base64 32
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_PG_PASSWORD=
# Client secret of the "naru-api" OIDC client. Keycloak (realm import) and the backend read the same value.
KEYCLOAK_NARU_API_SECRET=
# Defaults are for the home server. For local development set:
#   KEYCLOAK_HOSTNAME=http://localhost:8180
#   KEYCLOAK_REDIRECT_URI=http://localhost:8081/login/oauth2/code/idp
#   KEYCLOAK_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/
#   IDP_ISSUER_URI=http://localhost:8180/realms/naruworks
# KEYCLOAK_HOSTNAME=https://idp.naruworks.com
# KEYCLOAK_REDIRECT_URI=https://api.naruworks.com/login/oauth2/code/idp
# KEYCLOAK_POST_LOGOUT_REDIRECT_URI=https://app.naruworks.com/
# IDP_ISSUER_URI=https://idp.naruworks.com/realms/naruworks
# Host port on 127.0.0.1 for Keycloak (Cloudflare Tunnel reaches it through the Docker network).
KEYCLOAK_HOST_PORT=8180

# Separate Google Calendar read-only OAuth client. Never commit real values.
GOOGLE_CALENDAR_CLIENT_ID=change_me_google_calendar_client_id
GOOGLE_CALENDAR_CLIENT_SECRET=change_me_google_calendar_client_secret
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8081/api/calendar/integrations/google/callback
# Generate with: openssl rand -base64 32
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=change_me_base64_encoded_32_byte_key

# Google Calendar background synchronization. ISO-8601 duration values are used.
NARU_GOOGLE_CALENDAR_SYNC_ENABLED=true
NARU_GOOGLE_CALENDAR_SYNC_INITIAL_DELAY=PT1M
NARU_GOOGLE_CALENDAR_SYNC_FIXED_DELAY=PT30M

# Development-only S3-compatible Drive storage. Generate a secret with: openssl rand -base64 32
# The access key must use uppercase ASCII letters and digits only; do not use Base64 output for it.
# RustFS is private to Docker except for its console at http://127.0.0.1:9001.
NARU_DRIVE_S3_ENDPOINT=http://rustfs:9000
NARU_DRIVE_S3_BUCKET=naru-drive
NARU_DRIVE_S3_ACCESS_KEY=CHANGE_ME_DRIVE_ACCESS_KEY
NARU_DRIVE_S3_SECRET_KEY=change_me_drive_s3_secret
