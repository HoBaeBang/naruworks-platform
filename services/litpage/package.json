{
  "name": "litpage",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": { "node": ">=26" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "pnpm --filter @nc/server dev",
    "dev:web": "pnpm --filter @nc/web dev",
    "build": "pnpm --filter @nc/web build",
    "start": "pnpm --filter @nc/server start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @nc/e2e test"
  }
}
