+# ---------------------------------------------------------------- usage (v0.1.7)
+# 숫자만 읽는다. 메시지 본문·도구 결과는 읽어서 버리고 어디에도 저장하지 않는다.
+CLAUDE_PROJECTS = Path.home() / ".claude" / "projects"
+CODEX_SESSIONS = Path.home() / ".codex" / "sessions"
+USAGE_SLACK_SEC = 120  # 잡 시작 전 이만큼 일찍 시작한 세션까지 포함
+
+
+def _ts(s):
+    try:
+        return _dt.datetime.fromisoformat(str(s).replace("Z", "+00:00")).astimezone()
+    except Exception:
+        return None
+
+
+def _claude_project_dir(cwd: Path) -> Path:
+    # Claude Code는 cwd의 영숫자 외 문자를 '-'로 바꾼 폴더명을 쓴다(2026-11-24 실측: naru-design 등) [특수문자 미확인]
+    return CLAUDE_PROJECTS / re.sub(r"[^A-Za-z0-9]", "-", str(cwd))
+
+
+def _claude_usage(path: Path):
+    seen, calls, tot, ctx_max, first = set(), 0, [0, 0, 0, 0], 0, None
+    with path.open(encoding="utf-8", errors="ignore") as f:
+        for line in f:
+            try:
+                o = json.loads(line)
+            except Exception:
+                continue
+            if first is None and o.get("timestamp"):
+                first = _ts(o["timestamp"])
+            m = o.get("message") if isinstance(o.get("message"), dict) else None
+            if o.get("type") != "assistant" or not m or not m.get("usage"):
+                continue
+            key = (m.get("id"), o.get("requestId"))   # content 블록마다 같은 usage가 반복 기록됨(실측) → 한 번만 센다
+            if key in seen:
+                continue
+            seen.add(key)
+            u = m["usage"]
+            v = [u.get("input_tokens") or 0, u.get("output_tokens") or 0,
+                 u.get("cache_creation_input_tokens") or 0, u.get("cache_read_input_tokens") or 0]
+            tot = [a + b for a, b in zip(tot, v)]
+            calls += 1
+            ctx_max = max(ctx_max, v[0] + v[2] + v[3])
+    return first, {"api_calls": calls, "input": tot[0], "output": tot[1], "cache_creation": tot[2],
+                   "cache_read": tot[3], "ctx_max": ctx_max}
+
+
+def _codex_usage(path: Path):
+    first, cwd, calls, total, ctx_max = None, None, 0, {}, 0
+    with path.open(encoding="utf-8", errors="ignore") as f:
+        for line in f:
+            try:
+                o = json.loads(line)
+            except Exception:
+                continue
+            if first is None and o.get("timestamp"):
+                first = _ts(o["timestamp"])
+            p = o.get("payload") or {}
+            if o.get("type") == "session_meta":
+                cwd = p.get("cwd")
+            if p.get("type") == "token_count" and p.get("info"):
+                calls += 1
+                total = p["info"].get("total_token_usage") or total
+                last = p["info"].get("last_token_usage") or {}
+                ctx_max = max(ctx_max, last.get("input_tokens") or 0)
+    cached = total.get("cached_input_tokens") or 0
+    return first, cwd, {"api_calls": calls, "input": (total.get("input_tokens") or 0) - cached,
+                        "output": total.get("output_tokens") or 0, "cache_creation": 0,
+                        "cache_read": cached, "ctx_max": ctx_max}
+
+
+def collect_usage(row) -> list:
+    """잡 시간대(created_at-120s ~ updated_at)에 같은 cwd에서 시작한 Claude·Codex 세션의 사용량 목록."""
+    if not row.get("cwd_path"):
+        return []
+    cwd = Path(row["cwd_path"])
+    start = _ts(row.get("started_at") or row.get("created_at"))
+    end = _ts(row.get("updated_at")) or _dt.datetime.now().astimezone()
+    if not start:
+        return []
+    lo = start - _dt.timedelta(seconds=USAGE_SLACK_SEC)
+    found = []
+    pdir = _claude_project_dir(cwd)
+    if pdir.is_dir():
+        for f in pdir.glob("*.jsonl"):
+            if _dt.datetime.fromtimestamp(f.stat().st_mtime).astimezone() < lo:
+                continue
+            first, u = _claude_usage(f)
+            if first and lo <= first <= end and u["api_calls"]:
+                found.append({"provider": "claude", "session": f.stem, **u})
+    if CODEX_SESSIONS.is_dir():
+        for day in {lo.date(), end.date()}:
+            ddir = CODEX_SESSIONS / f"{day:%Y}" / f"{day:%m}" / f"{day:%d}"
+            for f in (ddir.glob("rollout-*.jsonl") if ddir.is_dir() else []):
+                first, scwd, u = _codex_usage(f)
+                if first and lo <= first <= end and scwd and Path(scwd) == cwd and u["api_calls"]:
+                    found.append({"provider": "codex", "session": f.stem, **u})
+    return found
+
+
+def record_usage(con, row) -> list:
+    rows = collect_usage(dict(row))
+    for u in rows:
+        con.execute("""INSERT OR REPLACE INTO job_usage(job_id,provider,session,api_calls,input,output,cache_creation,cache_read,ctx_max,recorded_at)
+                       VALUES(?,?,?,?,?,?,?,?,?,?)""",
+                    (row["id"], u["provider"], u["session"], u["api_calls"], u["input"], u["output"],
+                     u["cache_creation"], u["cache_read"], u["ctx_max"], now()))
+    return rows
+
+
+def _record_usage_safe(con, row) -> None:
+    try:
+        rows = record_usage(con, get_job(con, row["id"]))
+        job_log(row["id"], f"usage recorded: {len(rows)} session(s)")
+    except Exception as e:  # 사용량 집계 실패는 잡 상태에 영향을 주지 않는다
+        job_log(row["id"], f"usage record failed: {type(e).__name__}: {e}"[:300])
+
+
+def cmd_usage(args, cfg):
+    con = db()
+    row = get_job(con, args.job_id)
+    if args.refresh:
+        record_usage(con, row)
+    rows = [dict(r) for r in con.execute("SELECT * FROM job_usage WHERE job_id=? ORDER BY provider, session", (row["id"],))]
+    total = {k: sum(r[k] for r in rows) for k in ("api_calls", "input", "output", "cache_creation", "cache_read")}
+    total["ctx_max"] = max([r["ctx_max"] for r in rows] or [0])
+    return out({"ok": True, "cmd": "usage", "job_id": row["id"], "sessions": rows, "total": total})
+
